# Copy to .env and fill in credentials. Never commit a real .env.
# Secrets are environment-only; the app reads them as SecretStr.

# --- Images ---
# Tag pulled for both GHCR application images. `latest` tracks main; pin a
# `sha-<short-commit>` or a `v<version>` tag for a pinned deployment.
IMAGE_TAG=latest

# --- Web ---
# Host port for the SPA. Bound to 127.0.0.1 only; front it with a proxy or VPN.
APP_PORT=8080

# --- PostgreSQL (mandatory; all state depends on it) ---
POSTGRES_USER=tmdb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tmdb_reminder

# --- TMDB (optional; absent -> search/tracking run in degraded mode) ---
# Accepts a v3 API key or a v4 read-access bearer token (auto-detected).
TMDB_API_KEY=
TMDB_REGION=DE
# Controls both TMDB content language and the browser UI language. English (en-*)
# and German (de-*) are localized; any other or invalid value shows the English
# UI. The full regional tag is still used for date/number formatting.
TMDB_LANGUAGE=en-US

# --- Gotify (optional; absent -> notifications run in degraded mode) ---
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5

# --- Scheduling ---
APP_TIMEZONE=Europe/Berlin
REMINDER_TIME=09:00

# --- Logging ---
LOG_LEVEL=INFO
